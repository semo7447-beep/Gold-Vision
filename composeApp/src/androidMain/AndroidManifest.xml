<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- صلاحية عادية (تُمنح تلقائياً بلا نافذة إذن) لمراقبة حالة الاتصال
         الفعلية بالشبكة، حتى تنعكس نقاط "مباشر/غير مباشر" فوراً لحظة
         انقطاع الإنترنت بدل انتظار محاولة تحديث تالية -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- مطلوبة من أندرويد 13 فأعلى لعرض إشعار سعر الذهب اليومي -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- مطلوبة فقط على أندرويد 9 فأقل (maxSdkVersion) لحفظ بطاقة السعر
         بالمعرض عبر MediaStore — من أندرويد 10 (Q) فأعلى التخزين النطاقي
         (Scoped Storage) يسمح بهذا دون أي صلاحية -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".GoldVisionApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.GoldVision">

        <!-- تتبّع الأعطال (Sentry) — لا يُرسل أي بيانات شخصية افتراضياً -->
        <meta-data
            android:name="io.sentry.dsn"
            android:value="https://4594ee5e4118aec9258a13123e25ae88@o4512068460150784.ingest.de.sentry.io/4512068560879696" />
        <meta-data
            android:name="io.sentry.send-default-pii"
            android:value="false" />
        <meta-data
            android:name="io.sentry.traces.sample-rate"
            android:value="0.0" />

        <!-- singleTask ضروري: بدونه، فتح التطبيق من ضغطة الويدجت (أو أي
             PendingIntent خارجي آخر) ينشئ نسخة MainActivity جديدة كل مرة
             فوق أي نسخة موجودة أصلاً بالخلفية، فتُفقد كل حالة Compose
             (بما فيها بوابة قفل البصمة) وكأن التطبيق ما فُتح من الأساس،
             بدل إحضار نفس النسخة الحالية للمقدمة فقط -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GoldVision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- اختصارات الضغط المطول على أيقونة التطبيق (res/xml/shortcuts.xml) —
                 مدعومة من أندرويد 7.1 (API 25) فأعلى، تُتجاهَل بصمت على ما دونه -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- يسمح بمشاركة ملفات PDF المُصدَّرة (PdfExport.android.kt) بأمان
             مع تطبيقات أخرى (حفظ/طباعة/إرسال)، بدون مشاركة الملف كـ file:// مباشرة -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ويدجت الشاشة الرئيسية لعرض السعر الحي (GoldPriceWidgetProvider.kt).
             exported="true" ضروري هنا (رغم أنه عادة يُفضَّل false للأمان)
             لأن شاشة "إضافة ويدجت" في الهاتف تنتمي لتطبيق آخر (الـ Launcher)،
             ولازم يكون هذا المكوّن ظاهراً له حتى يقدر يكتشف وجود الويدجت
             ويعرضه في قائمة الويدجتات المتاحة -->
        <receiver
            android:name=".GoldPriceWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gold_price_widget_info" />
        </receiver>

        <!-- ويدجت ثانٍ منفصل لعرض قيمة المحفظة الحية (GoldPortfolioWidgetProvider.kt) -->
        <receiver
            android:name=".GoldPortfolioWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gold_portfolio_widget_info" />
        </receiver>

    </application>

</manifest>
