<?xml version="1.0" encoding="utf-8"?>
<!-- تخطيط الويدجت الفعلي — تُحدَّث نصوصه عبر RemoteViews من
     GoldPriceWidgetProvider.kt، بلا حاجة لأي مكتبة إضافية (نفس واجهة
     ويدجتات أندرويد القياسية والمستقرة منذ سنوات طويلة) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ic_launcher_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GOLD VISION"
            android:textColor="@color/widget_gold"
            android:textSize="16sp"
            android:textStyle="bold" />
        <!-- زر تحديث يدوي فوري — منفصل عن باقي الويدجت (يفتح التطبيق).
             حجم ثابت 40dp (بدل wrap_content+padding صغير) حتى تكون منطقة
             اللمس واضحة الحدود ولا تختلط بمنطقة "فتح التطبيق" المحيطة بها -->
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/widget_gold"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_label_24"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="24 عيار"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_price_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F4F4F4"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_label_22"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="22 عيار"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_price_22"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F4F4F4"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_label_21"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="21 عيار"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_price_21"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/widget_gold"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_label_18"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="18 عيار"
            android:textColor="#B8B8B8"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_price_18"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F4F4F4"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- نقطة حالة الاتصال: خضراء عند نجاح آخر تحديث فعلي، حمراء عند
             فشله (بدل ما كانت تختفي دون أي مؤشر) -->
        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/dot_circle"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_updated_at"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#777777"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
