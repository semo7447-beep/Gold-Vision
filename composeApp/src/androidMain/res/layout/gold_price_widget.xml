<?xml version="1.0" encoding="utf-8"?>
<!-- تخطيط الويدجت الفعلي — تُحدَّث نصوصه عبر RemoteViews من
     GoldPriceWidgetProvider.kt، بلا حاجة لأي مكتبة إضافية (نفس واجهة
     ويدجتات أندرويد القياسية والمستقرة منذ سنوات طويلة) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ic_launcher_background"
    android:padding="14dp">

    <!-- الرأس: التاريخ يميناً، شعار GOLD VISION يساراً، وزر تحديث يدوي
         صغير ملاصق للشعار (منطقة لمس منفصلة عن باقي الويدجت) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#B8B8B8"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="GOLD VISION"
            android:textColor="@color/widget_gold"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/widget_gold"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- شارة "مباشر"/"غير محدث" -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/dot_circle"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_updated_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B8B8B8"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#9B7300" />

    <!-- سعر عيار 24 البارز + نسبة تغيّر اليوم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
            android:id="@+id/widget_big_karat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24 عيار"
            android:textColor="@color/widget_gold"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_big_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="ريال/جرام"
                android:textColor="#B8B8B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_big_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#F4F4F4"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_big_change_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill_bg_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">
            <TextView
                android:id="@+id/widget_big_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#9B7300" />

    <!-- ثلاث بوكسات صغيرة: عيار 18 / 21 / 22 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_box_border"
            android:padding="8dp">
            <TextView
                android:id="@+id/widget_small_label_18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18 عيار"
                android:textColor="@color/widget_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_small_price_18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="--"
                android:textColor="#F4F4F4"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_box_border"
            android:padding="8dp">
            <TextView
                android:id="@+id/widget_small_label_21"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21 عيار"
                android:textColor="@color/widget_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_small_price_21"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="--"
                android:textColor="#F4F4F4"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_box_border"
            android:padding="8dp">
            <TextView
                android:id="@+id/widget_small_label_22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22 عيار"
                android:textColor="@color/widget_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_small_price_22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="--"
                android:textColor="#F4F4F4"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- بوكسا الافتتاح/الإغلاق لعياري 21 و24 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/widget_box_border"
            android:padding="8dp">
            <TextView
                android:id="@+id/widget_oc21_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="سعر الذهب عيار 21"
                android:textColor="#F4F4F4"
                android:textSize="10sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#9B7300" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_oc21_open_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="افتتاح"
                    android:textColor="#B8B8B8"
                    android:textSize="9.5sp" />
                <TextView
                    android:id="@+id/widget_oc21_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F4F4F4"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_oc21_close_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="إغلاق"
                    android:textColor="#B8B8B8"
                    android:textSize="9.5sp" />
                <TextView
                    android:id="@+id/widget_oc21_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F4F4F4"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/widget_oc21_change_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/pill_bg_green"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/widget_oc21_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/widget_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_box_border"
            android:padding="8dp">
            <TextView
                android:id="@+id/widget_oc24_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="سعر الذهب عيار 24"
                android:textColor="#F4F4F4"
                android:textSize="10sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#9B7300" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_oc24_open_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="افتتاح"
                    android:textColor="#B8B8B8"
                    android:textSize="9.5sp" />
                <TextView
                    android:id="@+id/widget_oc24_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F4F4F4"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_oc24_close_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="إغلاق"
                    android:textColor="#B8B8B8"
                    android:textSize="9.5sp" />
                <TextView
                    android:id="@+id/widget_oc24_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F4F4F4"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/widget_oc24_change_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/pill_bg_green"
                android:gravity="center"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/widget_oc24_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/widget_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
