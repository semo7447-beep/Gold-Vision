<?xml version="1.0" encoding="utf-8"?>
<!-- اختصار ثابت يظهر عند الضغط المطول على أيقونة التطبيق بالشاشة
     الرئيسية — "مشاركة التطبيق" يفتح نافذة المشاركة القياسية مباشرة
     دون الحاجة لفتح التطبيق أولاً -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="share_app"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_share_app_short"
        android:shortcutLongLabel="@string/shortcut_share_app_long">
        <intent
            android:action="com.goldvision.action.SHARE_APP"
            android:targetPackage="com.goldvision"
            android:targetClass="com.goldvision.MainActivity" />
    </shortcut>
</shortcuts>
